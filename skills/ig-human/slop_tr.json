      "regex": "\\bsadece [^.!?\\n]{2,60} değil,? (?:aynı zamanda|ayrıca|bir de)\\b",
      "name": "\"Sadece X değil, aynı zamanda Y\"",
      "fix": "Asıl kastettiğin tek şeyi söyle. Hazırlık yarısını sil."
    },
    {
      "id": "hem-hem-de",
      "regex": "\\bhem [^.!?\\n]{2,60} hem de\\b",
      "name": "\"Hem X hem de Y\"",
      "fix": "İki cümleye böl ya da zayıf yarısını at."
    },
    {
      "id": "mesele-degil",
      "regex": "\\b(?:mesele|konu|olay|bu)\\b[^.!?\\n]{2,60}\\b(?:değil)[.!,]\\s*(?:mesele|asıl mesele|olay|asıl olay)\\b",
      "name": "\"Mesele X değil. Mesele Y.\"",
      "fix": "Y ile başla. Ters çevirme kalıbın kendisi ele veriyor."
    },
    {
      "id": "soru-satiri",
      "regex": "(?m)^\\s*(?:sonuç|peki sonuç|işin güzel yanı|en güzel yanı|püf noktası|sır|cevap)\\s?(?:mu|mı|ne)?\\?\\s*$",
      "name": "Tek kelimelik retorik soru satırı (\"Sonuç mu?\")",
      "fix": "Soruyu sil, cevabı doğrudan söyle."
    },
    {
      "id": "nasil-mi",
      "regex": "\\b(?:nasıl|neden|niye|ne) m[ıi]\\?",
      "name": "\"Nasıl mı?\" / \"Neden mi?\"",
      "fix": "Kendi sorduğun soruya geçiş yapma. Cevabı cümleye koy."
    },
    {
      "id": "iste-ogrendiklerim",
      "regex": "\\bişte (?:öğrendiklerim|öğrendiğim\\w*|bildiklerim)\\b",
      "name": "\"İşte öğrendiklerim\"",
      "fix": "Öğrendiğin ilk şeyle başla."
    },
    {
      "id": "yazi-dili-kipi",
      "regex": "\\b\\w+(?:mekte|makta)(?:dır|dir)\\b",
      "name": "Yazı dili kipi (-mektedir / -maktadır)",
      "fix": "Konuşur gibi yaz: 'sağlamaktadır' değil 'sağlıyor', 'kullanılmaktadır' değil 'kullanılıyor'."
    },
    {
      "id": "vaaz-tonu",
      "regex": "\\b\\w+m[ae]l[ıi](?:d[ıi]r|yız|yiz|sınız|siniz)\\b",
      "name": "Vaaz tonu (-malıdır / -malıyız / -melisiniz)",
      "fix": "Öğüt verme, ne yaptığını anlat: 'yapmalısınız' değil 'ben şunu yapıyorum'."
    },
    {
      "id": "uclu",
      "regex": "\\b\\w+, \\w+ ve \\w+\\.",
      "name": "Üçlü sıralama (\"X, Y ve Z.\")",
      "fix": "Üçten birini sil. İkisi daha inandırıcı, üçü kalıp gibi."
    },
    {
      "id": "roket",
      "regex": "[🚀🔥💡✨🎯]",
      "name": "Roket / ateş / ampul / pırıltı / hedef emojisi",
      "fix": "Sil. Bu beşi yapay zeka metninin imzası."
    },
    {
      "id": "hashtag-duvari",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Hashtag duvarı (5+)",
      "fix": "En fazla üç, açıklamanın en altında."
    },
    {
      "id": "yapay-zeka-olarak",
      "regex": "\\bbir yapay zeka (?:olarak|modeli olarak)\\b|\\bbir dil modeli olarak\\b",
      "name": "Modelin kendinden bahsetmesi",
      "fix": "Sil."
    },
    {
      "id": "ozetle-acilis",
      "regex": "(?m)^\\s*(?:özetle|özetlemek gerekirse|sonuç olarak|toparlamak gerekirse)\\b",
      "name": "Kompozisyon kapanışı",
      "fix": "Özet yapma. Son cümle zaten özet olmalı."
    },
    {
      "id": "etkilesim-yemi",
      "regex": "\\b(?:katılıyor musun(?:uz)?\\?|ne düşünüyorsun(?:uz)?\\?|sizce\\?|yanılıyor muyum\\?|bir tek ben mi\\b)\\s*$",
      "name": "Refleks etkileşim yemi",
      "fix": "Gerçek, cevaplanabilir bir soru sor ya da hiç sorma."
    },
    {
      "id": "kaydirma",
      "regex": "(?m)^\\s*(?:kaydırmayı bırak|kaydırma|geçme|dur[,.!]? geçme)\\b",
      "name": "\"Kaydırma\" açılışı",
      "fix": "Sil ve vaatle aç."
    },
    {
      "id": "bu-videoda",
      "regex": "\\b(?:bu videoda|bugünkü videoda|bugünkü videomuzda|bu reels'?te|bu içerikte)\\b|\\bsize [^.!?\\n]{0,30}(?:göstereceğim|anlatacağım)\\b",
      "name": "Video girizgâhı (\"bu videoda size ... göstereceğim\")",
      "fix": "Sil. Video, girizgâhtan sonraki cümleyle başlar."
    },
    {
      "id": "emoji-madde",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
      "name": "Emoji madde işaretli liste",
      "fix": "Tire kullan ya da düz cümle yaz."
    },
    {
      "id": "bagiran",
      "regex": "\\b[A-ZÇĞİÖŞÜ]{3,}\\b(?:\\s+\\b[A-ZÇĞİÖŞÜ]{3,}\\b){2,}",
      "name": "Art arda üç ve daha fazla büyük harfli kelime",
      "fix": "Tek kelimeyi vurgula, gerisini normal yaz.",
      "raw": true
    },
    {
      "id": "takip-yemi",
      "regex": "\\b(?:takip et(?:meyi unutma)?|etiketle|beğen(?:meyi unutma)?|kaydet(?:meyi unutma)?|paylaş(?:mayı unutma)?)\\b[^.!?\\n]{0,30}(?:unutma|ihtiyacı olan|arkadaşını)",
      "name": "Refleks takip / etiket yemi",
      "fix": "Tek bir çağrı bırak ve sebebini söyle: 'kaydet, cuma lazım olacak'."
    }
  ]
}